staged_files=$(git -c core.quotePath=false diff --cached --name-only --diff-filter=ACMR)
[ -n "$staged_files" ] || exit 0

result=0

# melos run format と同じく自動生成ファイルを除く
dart_files=$(printf '%s\n' "$staged_files" | grep -E '\.dart$' | grep -vE '(^|/)gen/|\.(g|freezed|gen|g\.theme)\.dart$' || true)
if [ -n "$dart_files" ]; then
  if ! printf '%s\n' "$dart_files" | tr '\n' '\0' | xargs -0 mise exec -- dart format --output=none --set-exit-if-changed; then
    echo "dart format の違反があります。表示されたファイルを dart format で直してください。" >&2
    result=1
  fi
fi

if ! mise exec -- dprint check --staged --allow-no-files; then
  echo "dprint の違反があります。dprint fmt で直してください。" >&2
  result=1
fi

if ! printf '%s\n' "$staged_files" | mise exec -- bun --bun run cspell lint --no-must-find-files --no-progress --file-list stdin; then
  echo "スペルの誤りがあります。直すか、docs/SPELL_CHECK.md に沿って辞書に追加してください。" >&2
  result=1
fi

if ! mise exec -- gitleaks git --staged --no-banner --redact --verbose; then
  echo "秘密情報が含まれています。コミットから取り除いてください。" >&2
  result=1
fi

exit $result
