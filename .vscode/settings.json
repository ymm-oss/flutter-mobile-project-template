// GitHubのテンプレート機能使用してリポジトリを作った際に、このファイルのコメントは削除されます
{
  // NOTE: miseで`.vscode/mise-tools`配下にシンボリックリンクを作成し、それをツールのパスとして利用します
  // settings.jsonは書き換えさせず、インストール済みの拡張向けのリンクだけを作成します
  "mise.configureExtensionsAutomatically": false,
  "mise.configureExtensionsUseSymLinks": true,
  // NOTE: プロジェクト外のツールまでリンクしないよう、グローバルなツールは含めません
  "mise.configureExtensionsIncludeGlobalTools": false,
  // NOTE: Flutter SDKの設定を読むのはDart拡張のため、Dart拡張向けにFlutter SDKのリンクを作成します
  // https://hverlin.github.io/mise-vscode/guides/custom-extensions/
  "mise.customFolderExtensions": [
    {
      "extensionId": "Dart-Code.dart-code",
      "toolSources": ["flutter"],
      "folderName": "flutter",
      "vscodeSetting": { "key": "dart.flutterSdkPath" }
    }
  ],
  // NOTE: dprintはmise-vscodeの対応拡張にないため、バイナリのリンクを作成します
  "mise.customBinaryExtensions": [
    {
      "extensionId": "dprint.dprint",
      "toolSources": ["dprint"],
      "binName": "dprint",
      "supportsShims": false,
      "supportsSymlinks": true,
      "vscodeSetting": { "key": "dprint.path" }
    }
  ],
  // NOTE: Bun拡張はVS Codeの変数を展開するため`${workspaceFolder}`を使います
  // Dart拡張とdprint拡張は`${workspaceFolder}`を展開しないため、ワークスペースからの相対パスで指定します
  "bun.runtime": "${workspaceFolder}/.vscode/mise-tools/bun",
  // NOTE: Dart SDKはFlutter SDK内の`bin/cache/dart-sdk`が使われるため、`dart.sdkPath`は指定しません
  "dart.flutterSdkPath": ".vscode/mise-tools/flutter",
  "dprint.path": ".vscode/mise-tools/dprint",
  "explorer.fileNesting.enabled": true,
  "explorer.fileNesting.patterns": {
    "*.dart": "$(capture).g.dart, $(capture).freezed.dart",
    "pubspec.yaml": "pubspec.lock, pubspec_overrides.yaml",
    "package.json": "bun.lock"
  },
  // GitHubのテンプレート機能使用してリポジトリを作った際に、
  // copilotの設定は無効化されるように上書きするワークフローが実行されます
  "github.copilot.enable": {
    "*": false,
    "markdown": true,
    "dart": true,
    "json": true,
    "yaml": true
  },
  "github.copilot.editor.enableCodeActions": true,
  "github.copilot.editor.enableAutoCompletions": true,
  "npm.packageManager": "bun",
  "files.insertFinalNewline": true,
  "files.trimFinalNewlines": true,
  "[json][jsonc][yaml][toml][markdown]": {
    "editor.defaultFormatter": "dprint.dprint"
  },
  "yaml.schemas": {
    "https://raw.githubusercontent.com/invertase/melos/main/melos.yaml.schema.json": "melos.yaml"
  },
  "arb-editor.suppressedWarnings": [
    // "@example": {} のようなメタデータがない場合の警告を無効化
    "missing_metadata_for_key"
  ]
}
